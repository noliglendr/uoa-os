# Copy this file to .env.local and fill in real values.
# .env.local is never committed. Keep this file up to date when you add a variable.
# Never put real client data or real secrets in this file.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email for deadline reminders (Resend, resend.com).
# Leave empty to run reminders as a "dry run": they are recorded in the app but not emailed.
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=reminders@example.com

# Secret the scheduler sends to /api/cron/escalations (Vercel Cron sends it automatically).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-secret

# Public URL of the app (used in reminder email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
